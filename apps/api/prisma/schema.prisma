generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                    @id @default(uuid()) @db.Uuid
  name                      String                    @db.VarChar(255)
  identity                  String                    @unique @db.VarChar(255)
  email                     String                    @unique @db.VarChar(255)
  phone                     String?                   @unique @db.VarChar(20)
  passwordHash              String                    @map("password_hash")
  role                      UserRole
  isVerified                Boolean                   @default(false) @map("is_verified")
  isActive                  Boolean                   @default(true) @map("is_active")
  guardianPhone             String?                   @map("guardian_phone") @db.VarChar(20)
  guardianIdentity          String?                   @map("guardian_identity") @db.VarChar(20)
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  courseProgresses          CourseProgress[]
  assignmentAttempts        AssignmentAttempt[]
  assignmentBestScores      AssignmentBestScore[]
  assistantPermissions      AssistantPermission[]     @relation("AssistantPerms")
  grantedPermissions        AssistantPermission[]     @relation("GrantedByPerms")
  taughtCourses             Course[]                  @relation("TeacherCourses")
  publishedCourses          Course[]                  @relation("CoursePublisher")
  archivedCourses           Course[]                  @relation("CourseArchiver")
  courseAuditLogs           CourseAuditLog[]
  enrolledByMe              Enrollment[]              @relation("EnrolledByUser")
  enrollments               Enrollment[]              @relation("StudentEnrollments")
  archivedAssignments       Assignment[]              @relation("AssignmentArchiver")
  lessonProgress            LessonProgress[]
  otpVerifications          OtpVerification[]
  parentLinks               ParentStudentLink[]       @relation("ParentSide")
  childLinks                ParentStudentLink[]       @relation("StudentSide")
  refreshTokens             RefreshToken[]
  createdSessions           LiveSession[]             @relation("CreatedSessions")
  cancelledSessions         LiveSession[]             @relation("CancelledSessions")
  sessionNotifications      LiveSessionNotification[]
  // Payment relations
  paidPayments              Payment[]                 @relation("PaymentPayer")
  studentPayments           Payment[]                 @relation("PaymentStudent")
  // promoCodeUsages = codes this user benefited from (as student)
  promoCodeUsages           PromoCodeUsage[]          @relation("PromoStudent")
  refundsRequested          Refund[]                  @relation("RefundRequester")
  // Generic notification inbox (payment confirmations, refunds, etc.)
  notifications             Notification[]
  // Promo codes this admin/assistant created — used for audit and accountability
  createdPromoCodes         PromoCode[]               @relation("PromoCodeCreator")
  approvalRequestsInitiated ApprovalRequest[]         @relation("RequestInitiator")
  approvalRequestsReviewed  ApprovalRequest[]         @relation("RequestReviewer")

  @@index([role])
  @@map("users")
}

model OtpVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  code      String    @db.Char(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("otp_verifications")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  // tokenHash is queried directly on every refresh token validation (WHERE token_hash = ?).
  // Without this index, every token validation is a full table scan.
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AssistantPermission {
  id              String   @id @default(uuid()) @db.Uuid
  assistantUserId String   @map("assistant_user_id") @db.Uuid
  permission      String   @db.VarChar(100)
  grantedBy       String   @map("granted_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  assistant       User     @relation("AssistantPerms", fields: [assistantUserId], references: [id])
  granter         User     @relation("GrantedByPerms", fields: [grantedBy], references: [id])

  @@unique([assistantUserId, permission])
  @@map("assistant_permissions")
}

model ParentStudentLink {
  id            String             @id @default(uuid()) @db.Uuid
  parentUserId  String             @map("parent_user_id") @db.Uuid
  studentUserId String             @map("student_user_id") @db.Uuid
  relationship  ParentRelationship
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  parent        User               @relation("ParentSide", fields: [parentUserId], references: [id])
  student       User               @relation("StudentSide", fields: [studentUserId], references: [id])

  @@unique([parentUserId, studentUserId, relationship])
  @@map("parent_student_links")
}

model Course {
  id                 String            @id @default(uuid()) @db.Uuid
  slug               String            @unique @db.VarChar(255)
  teacherUserId      String            @map("teacher_user_id") @db.Uuid
  title              String            @db.VarChar(255)
  category           String?
  description        String?
  thumbnailUrl       String?           @map("thumbnail_url")
  promoVideoUrl      String?           @map("promo_video_url")
  promoVideoProvider VideoProvider?    @map("promo_video_provider")
  price              Decimal           @db.Decimal(10, 2)
  // SAR is the actual charge currency (Moyasar only supports SAR).
  // To show international users an equivalent in their currency, use a live
  // exchange rate API at display time.
  currency           String            @default("SAR") @db.VarChar(3)
  status             CourseStatus      @default(DRAFT)
  publishedAt        DateTime?         @map("published_at") @db.Timestamptz(6)
  publishedBy        String?           @map("published_by") @db.Uuid
  archivedAt         DateTime?         @map("archived_at") @db.Timestamptz(6)
  archivedBy         String?           @map("archived_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  teacher            User              @relation("TeacherCourses", fields: [teacherUserId], references: [id])
  publishedByUser    User?             @relation("CoursePublisher", fields: [publishedBy], references: [id])
  archivedByUser     User?             @relation("CourseArchiver", fields: [archivedBy], references: [id])
  courseProgresses   CourseProgress[]
  chapters           Chapter[]
  auditLogs          CourseAuditLog[]
  enrollments        Enrollment[]
  liveSessions       LiveSession[]
  payments           Payment[]
  promoCodes         PromoCode[]
  approvalRequests   ApprovalRequest[]

  @@index([teacherUserId])
  @@index([category])
  @@index([status])
  @@map("courses")
}

model CourseAuditLog {
  id          String            @id @default(uuid()) @db.Uuid
  courseId    String            @map("course_id") @db.Uuid
  action      CourseAuditAction @map("action")
  performedBy String            @map("performed_by") @db.Uuid
  performedAt DateTime          @default(now()) @map("performed_at") @db.Timestamptz(6)
  metadata    Json? // snapshot of what changed

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [performedBy], references: [id])

  @@index([courseId])
  @@index([performedBy])
  @@index([metadata], type: Gin)
  @@map("course_audit_logs")
}

model CourseProgress {
  id               String    @id @default(uuid()) @db.Uuid
  studentUserId    String    @map("student_user_id") @db.Uuid
  courseId         String    @map("course_id") @db.Uuid
  lastLessonId     String?   @map("last_lesson_id") @db.Uuid
  completedLessons Int       @default(0) @map("completed_lessons")
  totalLessons     Int       @map("total_lessons")
  progressPct      Int       @default(0) @map("progress_pct")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  course           Course    @relation(fields: [courseId], references: [id])
  student          User      @relation(fields: [studentUserId], references: [id])
  lastLesson       Lesson?   @relation("LastLessonBookmark", fields: [lastLessonId], references: [id])

  @@unique([studentUserId, courseId])
  @@map("course_progress")
}

model Chapter {
  id         String    @id @default(uuid()) @db.Uuid
  courseId   String    @map("course_id") @db.Uuid
  title      String    @db.VarChar(255)
  orderIndex Int       @map("order_index")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons    Lesson[]

  @@unique([courseId, orderIndex])
  @@map("chapters")
}

model Lesson {
  id                String            @id @default(uuid()) @db.Uuid
  chapterId         String            @map("chapter_id") @db.Uuid
  title             String            @db.VarChar(255)
  orderIndex        Int               @map("order_index")
  videoUrl          String            @default("") @map("video_url")
  videoProvider     VideoProvider     @default(YOUTUBE) @map("video_provider")
  version           Int               @default(1)
  archivedAt        DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment        Assignment?
  lessonProgress    LessonProgress[]
  progressBookmarks CourseProgress[]  @relation("LastLessonBookmark")
  chapter           Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  approvalRequests  ApprovalRequest[]

  @@unique([chapterId, orderIndex])
  @@index([archivedAt])
  @@map("lessons")
}

model Assignment {
  id              String                @id @default(uuid()) @db.Uuid
  lessonId        String                @unique @map("lesson_id") @db.Uuid
  passingScorePct Int                   @map("passing_score_pct") @db.SmallInt
  maxAttempts     Int?                  @map("max_attempts")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime?             @map("archived_at") @db.Timestamptz(6)
  archivedBy      String?               @map("archived_by") @db.Uuid
  attempts        AssignmentAttempt[]
  bestScores      AssignmentBestScore[]
  lesson          Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions       Question[]
  archivedByUser  User?                 @relation("AssignmentArchiver", fields: [archivedBy], references: [id])

  @@map("assignments")
}

model Question {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  text         String
  orderIndex   Int              @map("order_index")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  options      QuestionOption[]
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  orderIndex Int      @map("order_index")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

// Decision: enrollment is activated ONLY after payment is confirmed (immediate, no reserved spots).
// PENDING state covers the brief window between payment initiation and Moyasar webhook confirmation.
// Offline enrollments by admin/assistant skip PENDING and go directly to ACTIVE.

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentUserId  String           @map("student_user_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  enrolledBy     String?          @map("enrolled_by") @db.Uuid
  // paymentId is null for free courses (price=0 or 100% promo) and offline enrollments
  paymentId      String?          @unique @map("payment_id") @db.Uuid
  // amountPaid = effective amount after any promo code discount
  amountPaid     Decimal          @map("amount_paid") @db.Decimal(10, 2)
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  status         EnrollmentStatus @default(PENDING) @map("status")
  expiryDate     DateTime?        @map("expiry_date") @db.Timestamptz(6)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrolledByUser User?            @relation("EnrolledByUser", fields: [enrolledBy], references: [id], onDelete: Restrict)
  student        User             @relation("StudentEnrollments", fields: [studentUserId], references: [id])
  payment        Payment?         @relation(fields: [paymentId], references: [id])

  @@unique([studentUserId, courseId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model LessonProgress {
  id               String    @id @default(uuid()) @db.Uuid
  studentUserId    String    @map("student_user_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  videoWatchedPct  Int       @default(0) @map("video_watched_pct") @db.SmallInt
  videoCompletedAt DateTime? @map("video_completed_at") @db.Timestamptz(6)
  isCompleted      Boolean   @default(false) @map("is_completed")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lesson           Lesson    @relation(fields: [lessonId], references: [id])
  student          User      @relation(fields: [studentUserId], references: [id])

  @@unique([studentUserId, lessonId])
  @@map("lesson_progress")
}

model AssignmentAttempt {
  id            String                @id @default(uuid()) @db.Uuid
  studentUserId String                @map("student_user_id") @db.Uuid
  assignmentId  String                @map("assignment_id") @db.Uuid
  attemptNumber Int                   @map("attempt_number")
  scorePct      Int                   @map("score_pct") @db.SmallInt
  isPassed      Boolean               @map("is_passed")
  submittedAt   DateTime              @default(now()) @map("submitted_at") @db.Timestamptz(6)
  snapshot      Json? // Frozen copy of questions/options at submission time
  assignment    Assignment            @relation(fields: [assignmentId], references: [id])
  student       User                  @relation(fields: [studentUserId], references: [id])
  bestScores    AssignmentBestScore[] @relation("BestAttemptLink")

  // Unique per student+assignment+attempt — prevents race-condition duplicate attempt numbers
  @@unique([studentUserId, assignmentId, attemptNumber])
  // (studentUserId, assignmentId) prefix is covered by the unique index above.
  // We only need assignmentId alone for teacher queries: "all attempts for this assignment"
  @@index([assignmentId])
  @@map("assignment_attempts")
}

model AssignmentBestScore {
  id            String             @id @default(uuid()) @db.Uuid
  studentUserId String             @map("student_user_id") @db.Uuid
  assignmentId  String             @map("assignment_id") @db.Uuid
  bestScorePct  Int                @map("best_score_pct") @db.SmallInt
  bestAttemptId String             @map("best_attempt_id") @db.Uuid
  isPassed      Boolean            @map("is_passed")
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment    Assignment         @relation(fields: [assignmentId], references: [id])
  student       User               @relation(fields: [studentUserId], references: [id])
  bestAttempt   AssignmentAttempt? @relation("BestAttemptLink", fields: [bestAttemptId], references: [id])

  @@unique([studentUserId, assignmentId])
  @@index([assignmentId])
  @@map("assignment_best_scores")
}

model LiveSession {
  id              String            @id @default(uuid()) @db.Uuid
  courseId        String            @map("course_id") @db.Uuid
  teacherUserId   String            @map("teacher_user_id") @db.Uuid
  title           String?           @db.VarChar(255)
  meetingUrl      String            @map("meeting_url")
  platform        SessionPlatform   @default(OTHER)
  scheduledAt     DateTime          @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int               @map("duration_minutes")
  status          LiveSessionStatus @default(SCHEDULED)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?           @map("cancelled_by") @db.Uuid
  cancelReason    String?           @map("cancel_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  course          Course                    @relation(fields: [courseId], references: [id])
  teacher         User                      @relation("CreatedSessions", fields: [teacherUserId], references: [id])
  cancelledByUser User?                     @relation("CancelledSessions", fields: [cancelledBy], references: [id])
  notifications   LiveSessionNotification[]

  @@index([courseId, scheduledAt])
  @@index([scheduledAt, status])
  @@index([teacherUserId])
  @@map("live_sessions")
}

model LiveSessionNotification {
  id          String             @id @default(uuid()) @db.Uuid
  sessionId   String             @map("session_id") @db.Uuid
  recipientId String             @map("recipient_id") @db.Uuid
  type        NotificationType
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  session     LiveSession        @relation(fields: [sessionId], references: [id])
  recipient   User               @relation(fields: [recipientId], references: [id])

  @@unique([sessionId, recipientId, type])
  @@index([status, type])
  @@map("live_session_notifications")
}

// ─────────────────────────────────────────────
// GENERIC NOTIFICATION SYSTEM
// Separate from LiveSessionNotification on purpose:
// LiveSessionNotification has a hard sessionId FK.
// Payment/refund notifications have no session — they'd
// cause a FK violation if forced into that table.
// ─────────────────────────────────────────────

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  recipientId   String              @map("recipient_id") @db.Uuid
  type          NotificationEvent   @map("type")
  channel       NotificationChannel @map("channel")
  status        NotificationStatus  @default(PENDING)
  // Polymorphic reference: points to the entity that triggered this notification.
  // referenceId = Payment.id or Refund.id; referenceType tells the service which table to join.
  referenceId   String?             @map("reference_id") @db.Uuid
  referenceType ReferenceType?      @map("reference_type")
  // Snapshot of data needed to render the notification template.
  // Avoids re-querying at send time (amounts, names, etc.) and
  // keeps a permanent record even if the source record changes.
  payload       Json?
  scheduledAt   DateTime?           @map("scheduled_at") @db.Timestamptz(6)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  recipient     User                @relation(fields: [recipientId], references: [id])

  @@index([recipientId, status])
  @@index([type, status])
  @@index([scheduledAt, status]) // for the notification sender cron job
  @@map("notifications")
}

// ─────────────────────────────────────────────
// PAYMENT SYSTEM
// ─────────────────────────────────────────────

model PromoCode {
  id            String           @id @default(uuid()) @db.Uuid
  code          String           @unique @db.VarChar(50) //that make an index
  discountType  DiscountType     @map("discount_type")
  // For PERCENTAGE: 0-100 (e.g. 20 = 20% off). For FIXED: amount in SAR
  discountValue Decimal          @map("discount_value") @db.Decimal(10, 2)
  maxUses       Int?             @map("max_uses") // null = unlimited
  usedCount     Int              @default(0) @map("used_count")
  // null courseId = code applies to ALL courses
  courseId      String?          @map("course_id") @db.Uuid
  startsAt      DateTime?        @map("starts_at") @db.Timestamptz(6)
  expiresAt     DateTime?        @map("expires_at") @db.Timestamptz(6)
  isActive      Boolean          @default(false) @map("is_active") // false = draft; set to true to activate
  // Who created this code — required for audit and accountability.
  // If an admin/assistant creates a 100% off code, you need to know who did it.
  createdBy     String           @map("created_by") @db.Uuid
  // Increment this when reactivating the same code for a new season (e.g. SUMMER20 every year).
  // PromoCodeUsage records are scoped per period, so a student who used the code
  // in period 1 is not blocked from using it in period 2.
  periodVersion Int              @default(1) @map("period_version")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  course        Course?          @relation(fields: [courseId], references: [id])
  creator       User             @relation("PromoCodeCreator", fields: [createdBy], references: [id])
  usages        PromoCodeUsage[]
  payments      Payment[]

  @@index([courseId])
  @@index([isActive, expiresAt])
  @@map("promo_codes")
}

model PromoCodeUsage {
  id            String    @id @default(uuid()) @db.Uuid
  promoCodeId   String    @map("promo_code_id") @db.Uuid
  // studentUserId = the STUDENT (beneficiary), NOT the payer.
  // A parent paying for 3 children can apply the same global code for each child.
  // Each student can only benefit from each code once per season (periodVersion).
  studentUserId String    @map("student_user_id") @db.Uuid
  // Snapshot of PromoCode.periodVersion at the time of use.
  // Must match the current periodVersion of the code at checkout (service layer validates).
  periodVersion Int       @map("period_version")
  usedAt        DateTime  @default(now()) @map("used_at") @db.Timestamptz(6)
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id])
  student       User      @relation("PromoStudent", fields: [studentUserId], references: [id])

  // One use per student per code per season
  @@unique([promoCodeId, studentUserId, periodVersion])
  @@map("promo_code_usages")
}

model Payment {
  id                 String                @id @default(uuid()) @db.Uuid
  orderId            String                @map("order_id") @db.VarChar(255)
  // Who initiated the payment (student paying for themselves, or parent paying for their child)
  payerUserId        String                @map("payer_user_id") @db.Uuid
  initiatorRole      PaymentInitiatorRole  @map("initiator_role")
  // The student who will be enrolled
  studentUserId      String                @map("student_user_id") @db.Uuid
  courseId           String                @map("course_id") @db.Uuid
  // Amount breakdown for clear audit trail
  originalAmount     Decimal               @map("original_amount") @db.Decimal(10, 2)
  discountAmount     Decimal               @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount        Decimal               @map("final_amount") @db.Decimal(10, 2)
  amount             Int
  currency           String                @default("SAR") @db.VarChar(3)
  refundedAmount     Int                   @default(0) @map("refunded_amount")
  capturedAmount     Int                   @default(0) @map("captured_amount")
  promoCodeId        String?               @map("promo_code_id") @db.Uuid
  // Moyasar gateway data
  moyasarPaymentId   String?               @unique @map("moyasar_payment_id") @db.VarChar(255)
  moyasarStatus      String?               @map("moyasar_status") @db.VarChar(50) // raw value from Moyasar webhook
  // NULLABLE: with hosted redirect, the user picks their method on Moyasar's page.
  // This is populated by the webhook (MADA, CREDIT_CARD, APPLE_PAY).
  // OFFLINE is set directly by admin/assistant at enrollment time.
  paymentMethod      PaymentMethod?        @map("payment_method")
  // Internal lifecycle status
  status             PaymentStatus         @default(initiated)
  // Prevents double-charge if user submits form twice — generated by backend before redirecting to Moyasar
  idempotencyKey     String                @unique @map("idempotency_key") @db.VarChar(255)
  paidAt             DateTime?             @map("paid_at") @db.Timestamptz(6)
  failedAt           DateTime?             @map("failed_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  metadata           Json?
  rawGatewayResponse Json?                 @map("raw_gateway_response")
  // Relations
  payer              User                  @relation("PaymentPayer", fields: [payerUserId], references: [id])
  student            User                  @relation("PaymentStudent", fields: [studentUserId], references: [id])
  course             Course                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  promoCode          PromoCode?            @relation(fields: [promoCodeId], references: [id])
  enrollment         Enrollment?
  refunds            Refund[]
  webhookEvents      PaymentWebhookEvent[]

  @@index([orderId])
  @@index([studentUserId])
  @@index([courseId])
  @@index([status])
  @@index([payerUserId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String?  @unique @map("event_id") @db.VarChar(255)
  paymentId        String?  @map("payment_id") @db.Uuid
  moyasarPaymentId String?  @map("moyasar_payment_id") @db.VarChar(255)
  eventType        String   @map("event_type") @db.VarChar(100)
  payload          Json
  processedAt      DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  payment          Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([moyasarPaymentId])
  @@index([eventType])
  @@map("payment_webhook_events")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @map("payment_id") @db.Uuid
  // The admin or assistant who approved/processed the refund
  requestedBy     String       @map("requested_by") @db.Uuid
  refundAmount    Decimal      @map("refund_amount") @db.Decimal(10, 2)
  currency        String       @default("SAR") @db.VarChar(3)
  reason          String?
  method          RefundMethod
  status          RefundStatus @default(PENDING)
  // Populated only for online refunds processed via Moyasar API
  moyasarRefundId String?      @unique @map("moyasar_refund_id") @db.VarChar(255)
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment         Payment      @relation(fields: [paymentId], references: [id])
  requestedByUser User         @relation("RefundRequester", fields: [requestedBy], references: [id])

  @@index([paymentId])
  @@index([status]) // for admin dashboard: "show all PENDING refunds"
  @@map("refunds")
}


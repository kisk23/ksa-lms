generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(255)
  identity             String                @unique @db.VarChar(255)
  phone                String?               @unique @db.VarChar(20)
  passwordHash         String                @map("password_hash")
  role                 UserRole
  isVerified           Boolean               @default(false) @map("is_verified")
  isActive             Boolean               @default(true) @map("is_active")
  guardianPhone        String?               @map("guardian_phone") @db.VarChar(20)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(6)
  courseProgresses     CourseProgress[]
  assignmentAttempts   AssignmentAttempt[]
  assignmentBestScores AssignmentBestScore[]
  assistantPermissions AssistantPermission[] @relation("AssistantPerms")
  grantedPermissions   AssistantPermission[] @relation("GrantedByPerms")
  taughtCourses        Course[]              @relation("TeacherCourses")
  enrolledByMe         Enrollment[]          @relation("EnrolledByUser")
  enrollments          Enrollment[]          @relation("StudentEnrollments")
  lessonProgress       LessonProgress[]
  otpVerifications     OtpVerification[]
  parentLinks          ParentStudentLink[]   @relation("ParentSide")
  childLinks           ParentStudentLink[]   @relation("StudentSide")
  refreshTokens        RefreshToken[]

  @@index([role])
  @@map("users")
}

model OtpVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  code      String    @db.Char(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("otp_verifications")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model AssistantPermission {
  id              String   @id @default(uuid()) @db.Uuid
  assistantUserId String   @map("assistant_user_id") @db.Uuid
  permission      String   @db.VarChar(100)
  grantedBy       String   @map("granted_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  assistant       User     @relation("AssistantPerms", fields: [assistantUserId], references: [id])
  granter         User     @relation("GrantedByPerms", fields: [grantedBy], references: [id])

  @@unique([assistantUserId, permission])
  @@map("assistant_permissions")
}

model ParentStudentLink {
  id            String             @id @default(uuid()) @db.Uuid
  parentUserId  String             @map("parent_user_id") @db.Uuid
  studentUserId String             @map("student_user_id") @db.Uuid
  relationship  ParentRelationship
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  parent        User               @relation("ParentSide", fields: [parentUserId], references: [id])
  student       User               @relation("StudentSide", fields: [studentUserId], references: [id])

  @@unique([parentUserId, studentUserId, relationship])
  @@map("parent_student_links")
}

model Course {
  id               String           @id @default(uuid()) @db.Uuid
  slug             String           @unique @db.VarChar(255)
  teacherUserId    String           @map("teacher_user_id") @db.Uuid
  title            String           @db.VarChar(255)
  description      String?
  price            Decimal          @db.Decimal(10, 2)
  status           CourseStatus     @default(DRAFT)
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  courseProgresses CourseProgress[]
  chapters         Chapter[]
  teacher          User             @relation("TeacherCourses", fields: [teacherUserId], references: [id])
  enrollments      Enrollment[]

  @@index([teacherUserId])
  @@index([status])
  @@map("courses")
}

model CourseProgress {
  id               String    @id @default(uuid()) @db.Uuid
  studentUserId    String    @db.Uuid
  courseId         String    @db.Uuid
  completedLessons Int       @default(0)
  totalLessons     Int
  progressPct      Int       @default(0)
  completedAt      DateTime?
  course           Course    @relation(fields: [courseId], references: [id])
  student          User      @relation(fields: [studentUserId], references: [id])

  @@unique([studentUserId, courseId])
}

model Chapter {
  id         String    @id @default(uuid()) @db.Uuid
  courseId   String    @map("course_id") @db.Uuid
  title      String    @db.VarChar(255)
  orderIndex Int       @map("order_index")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  course     Course    @relation(fields: [courseId], references: [id])
  lessons    Lesson[]

  @@unique([courseId, orderIndex])
  @@index([courseId, orderIndex])
  @@map("chapters")
}

model Lesson {
  id             String           @id @default(uuid()) @db.Uuid
  chapterId      String           @map("chapter_id") @db.Uuid
  title          String           @db.VarChar(255)
  orderIndex     Int              @map("order_index")
  youtubeVideoId String           @map("youtube_video_id") @db.VarChar(20)
  version        Int              @default(1)
  isArchived     Boolean          @default(false) @map("is_archived")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment     Assignment?
  lessonProgress LessonProgress[]
  chapter        Chapter          @relation(fields: [chapterId], references: [id])

  @@unique([chapterId, orderIndex])
  @@index([chapterId, orderIndex])
  @@index([isArchived])
  @@map("lessons")
}

model Assignment {
  id              String                @id @default(uuid()) @db.Uuid
  lessonId        String                @unique @map("lesson_id") @db.Uuid
  passingScorePct Int                   @map("passing_score_pct") @db.SmallInt
  maxAttempts     Int?                  @map("max_attempts")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  attempts        AssignmentAttempt[]
  bestScores      AssignmentBestScore[]
  lesson          Lesson                @relation(fields: [lessonId], references: [id])
  questions       Question[]

  @@map("assignments")
}

model Question {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  text         String
  orderIndex   Int              @map("order_index")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  options      QuestionOption[]
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  orderIndex Int      @map("order_index")
  question   Question @relation(fields: [questionId], references: [id])

  @@index([questionId])
  @@map("question_options")
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentUserId  String           @map("student_user_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  enrolledBy     String?          @map("enrolled_by") @db.Uuid
  amountPaid     Decimal          @map("amount_paid") @db.Decimal(10, 2)
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  status         EnrollmentStatus @default(ACTIVE) @map("status")
  expiryDate     DateTime?        @map("expiry_date") @db.Timestamptz(6)
  course         Course           @relation(fields: [courseId], references: [id])
  enrolledByUser User?            @relation("EnrolledByUser", fields: [enrolledBy], references: [id], onDelete: Restrict)
  student        User             @relation("StudentEnrollments", fields: [studentUserId], references: [id])

  @@unique([studentUserId, courseId])
  @@index([studentUserId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id               String    @id @default(uuid()) @db.Uuid
  studentUserId    String    @map("student_user_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  lessonVersion    Int       @map("lesson_version")
  videoWatchedPct  Int       @default(0) @map("video_watched_pct") @db.SmallInt
  videoCompletedAt DateTime? @map("video_completed_at") @db.Timestamptz(6)
  isCompleted      Boolean   @default(false) @map("is_completed")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lesson           Lesson    @relation(fields: [lessonId], references: [id])
  student          User      @relation(fields: [studentUserId], references: [id])

  @@unique([studentUserId, lessonId])
  @@index([studentUserId])
  @@map("lesson_progress")
}

model AssignmentAttempt {
  id            String     @id @default(uuid()) @db.Uuid
  studentUserId String     @map("student_user_id") @db.Uuid
  assignmentId  String     @map("assignment_id") @db.Uuid
  attemptNumber Int        @map("attempt_number")
  scorePct      Int        @map("score_pct") @db.SmallInt
  isPassed      Boolean    @map("is_passed")
  submittedAt   DateTime   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  student       User       @relation(fields: [studentUserId], references: [id])

  @@index([studentUserId, assignmentId])
  @@map("assignment_attempts")
}

model AssignmentBestScore {
  id            String     @id @default(uuid()) @db.Uuid
  studentUserId String     @map("student_user_id") @db.Uuid
  assignmentId  String     @map("assignment_id") @db.Uuid
  bestScorePct  Int        @map("best_score_pct") @db.SmallInt
  isPassed      Boolean    @map("is_passed")
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  student       User       @relation(fields: [studentUserId], references: [id])

  @@unique([studentUserId, assignmentId])
  @@map("assignment_best_scores")
}

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  ASSISTANT_ADMIN
  SUPER_ADMIN
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

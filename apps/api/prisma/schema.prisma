// ──────────────────────────────────────────
// LMS Platform — Prisma Schema (DOC-21)
// Phase 1: Core LMS — no wallet/XP/leaderboard
// ──────────────────────────────────────────



// A lesson must be completed before assignment
// A student must pass before progressing
// Chapter order is respected      



// we need to add model for check wich chapter student start from it 
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  ASSISTANT_ADMIN
  SUPER_ADMIN
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

// ═══════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  identity        String    @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.Text
  role         UserRole
  isVerified   Boolean   @default(false) @map("is_verified")
  isActive     Boolean   @default(true) @map("is_active")
  guardianPhone String?   @map("guardian_phone") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  // ── Relations ──
  otpVerifications          OtpVerification[]
  refreshTokens             RefreshToken[]

  // Teacher
  taughtCourses             Course[]               @relation("TeacherCourses")

  // Student
  enrollments               Enrollment[]           @relation("StudentEnrollments")
  lessonProgress            LessonProgress[]
  assignmentAttempts        AssignmentAttempt[]
  assignmentBestScores      AssignmentBestScore[]
  courseProgresses          CourseProgress[]

  // Parent ↔ Student links
  parentLinks               ParentStudentLink[]    @relation("ParentSide")
  childLinks                ParentStudentLink[]    @relation("StudentSide")

  // Assistant admin
  assistantPermissions      AssistantPermission[]  @relation("AssistantPerms")
  grantedPermissions        AssistantPermission[]  @relation("GrantedByPerms")

  // Enrollment enrolled_by (nullable)
  enrolledByMe              Enrollment[]           @relation("EnrolledByUser")

  // Leaderboard (Phase 2)
  // studentXp             StudentXp?
  // leaderboardSnapshots  LeaderboardWeeklySnapshot[]

  @@index([role])
  @@map("users")
}

model OtpVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  code      String    @db.Char(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("otp_verifications")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("refresh_tokens")
}

model AssistantPermission {
  id              String   @id @default(uuid()) @db.Uuid
  assistantUserId String   @map("assistant_user_id") @db.Uuid
  permission      String   @db.VarChar(100)
  grantedBy       String   @map("granted_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  assistant User @relation("AssistantPerms", fields: [assistantUserId], references: [id], onDelete: Restrict)
  granter   User @relation("GrantedByPerms", fields: [grantedBy], references: [id], onDelete: Restrict)

  @@unique([assistantUserId, permission])
  @@map("assistant_permissions")
}

model ParentStudentLink {
  id            String             @id @default(uuid()) @db.Uuid
  parentUserId  String             @map("parent_user_id") @db.Uuid
  studentUserId String             @map("student_user_id") @db.Uuid
  relationship  ParentRelationship
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  parent  User @relation("ParentSide", fields: [parentUserId], references: [id], onDelete: Restrict)
  student User @relation("StudentSide", fields: [studentUserId], references: [id], onDelete: Restrict)

  @@unique([parentUserId, studentUserId, relationship])
  @@map("parent_student_links")
}

// ═══════════════════════════════════════════
// COURSE CONTENT
// ═══════════════════════════════════════════
 enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}


model Course {
  id            String    @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(255)
  teacherUserId String    @map("teacher_user_id") @db.Uuid
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  price         Decimal   @db.Decimal(10, 2)
  status        CourseStatus  @default(DRAFT)  
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  teacher          User            @relation("TeacherCourses", fields: [teacherUserId], references: [id], onDelete: Restrict)
  chapters         Chapter[]
  enrollments      Enrollment[]
  courseProgresses CourseProgress[]

  @@index([teacherUserId])
  @@index([status])
  @@map("courses")
}




//course progress
model CourseProgress {
  id             String   @id @default(uuid()) @db.Uuid
  studentUserId  String   @db.Uuid
  courseId       String   @db.Uuid
  completedLessons Int    @default(0)
  totalLessons     Int
  progressPct      Int    @default(0)
  completedAt      DateTime?

  student User   @relation(fields: [studentUserId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentUserId, courseId])
}
model Chapter {
  id         String    @id @default(uuid()) @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  title      String    @db.VarChar(255)
  orderIndex Int       @map("order_index")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lessons Lesson[]

  @@index([courseId, orderIndex]) 
  // to make sure the order index is unique for each course
  @@unique([courseId, orderIndex])
  @@map("chapters")
}

model Lesson {
  id             String   @id @default(uuid()) @db.Uuid
  chapterId      String   @map("chapter_id") @db.Uuid
  title          String   @db.VarChar(255)
  orderIndex     Int      @map("order_index")
  youtubeVideoId String   @map("youtube_video_id") @db.VarChar(20)
  // videoXp        Int      @map("video_xp") //phase 2
  version        Int      @default(1)
  //do we really need this? 
  isArchived     Boolean  @default(false) @map("is_archived")

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  assignment     Assignment?
  lessonProgress LessonProgress[]

  @@index([chapterId, orderIndex])
  // to make sure the order index is unique for each lesson ?
  @@unique([chapterId, orderIndex])
  @@index([isArchived])
  @@map("lessons")
}

// ═══════════════════════════════════════════
// ASSIGNMENTS & QUESTIONS
// ═══════════════════════════════════════════

model Assignment {
  id               String   @id @default(uuid()) @db.Uuid
  lessonId         String   @unique @map("lesson_id") @db.Uuid
  passingScorePct  Int      @map("passing_score_pct") @db.SmallInt
  // xpValue          Int      @map("xp_value") //phase 2

// const attemptsCount = await prisma.assignmentAttempt.count({
//   where: {
//     studentUserId,
//     assignmentId
//   }
// })

// if (assignment.maxAttempts !== null && attemptsCount >= assignment.maxAttempts) {
//   throw new Error("Max attempts reached")
// }

  maxAttempts      Int?     @map("max_attempts")
  // maybe shuffleOptions is not needed cause we can do it in the frontend
  // shuffleQuestions Boolean  @default(false) @map("shuffle_questions") //ask 
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  lesson     Lesson              @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  questions  Question[]
  attempts   AssignmentAttempt[]
  bestScores AssignmentBestScore[]

  @@map("assignments")
}

model Question {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  text         String   @db.Text
  orderIndex   Int      @map("order_index")
  // shuffleOptions Boolean @default(false) @map("shuffle_Options")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  options    QuestionOption[]

  @@index([assignmentId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  text       String  @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")
  orderIndex Int     @map("order_index")

  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([questionId])
  @@map("question_options")
}

// ═══════════════════════════════════════════
// ENROLLMENTS & PROGRESS
// ═══════════════════════════════════════════

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model Enrollment {
  id            String   @id @default(uuid()) @db.Uuid
  studentUserId String   @map("student_user_id") @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  enrolledBy    String?  @map("enrolled_by") @db.Uuid
  amountPaid    Decimal  @map("amount_paid") @db.Decimal(10, 2)
  enrolledAt    DateTime @default(now()) @map("enrolled_at") @db.Timestamptz
  status        EnrollmentStatus @default(ACTIVE) @map("status")
  expiryDate    DateTime? @map("expiry_date") @db.Timestamptz

  student    User   @relation("StudentEnrollments", fields: [studentUserId], references: [id], onDelete: Restrict)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrolledByUser User? @relation("EnrolledByUser", fields: [enrolledBy], references: [id], onDelete: Restrict)

  @@unique([studentUserId, courseId])
  @@index([studentUserId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id               String    @id @default(uuid()) @db.Uuid
  studentUserId    String    @map("student_user_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  lessonVersion    Int       @map("lesson_version")
  videoWatchedPct  Int       @default(0) @map("video_watched_pct") @db.SmallInt
  videoCompletedAt DateTime? @map("video_completed_at") @db.Timestamptz
  // videoXpEarned    Int       @default(0) @map("video_xp_earned") //phase 2
  //   if (videoWatchedPct >= 80 && assignmentPassed) {
//   isCompleted = true
// }
  isCompleted    Boolean  @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  student User   @relation(fields: [studentUserId], references: [id], onDelete: Restrict)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([studentUserId, lessonId])
  @@index([studentUserId])
  @@map("lesson_progress")
}

model AssignmentAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  studentUserId       String   @map("student_user_id") @db.Uuid
  assignmentId        String   @map("assignment_id") @db.Uuid
  attemptNumber       Int      @map("attempt_number")
  scorePct            Int      @map("score_pct") @db.SmallInt
  isPassed            Boolean  @map("is_passed")
  // xpEarnedThisAttempt Int      @default(0) @map("xp_earned_this_attempt") //phase 2
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  student    User       @relation(fields: [studentUserId], references: [id], onDelete: Restrict)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([studentUserId, assignmentId])
  @@map("assignment_attempts")
}

model AssignmentBestScore {
  id             String   @id @default(uuid()) @db.Uuid
  studentUserId  String   @map("student_user_id") @db.Uuid
  assignmentId   String   @map("assignment_id") @db.Uuid
  bestScorePct   Int      @map("best_score_pct") @db.SmallInt
  // totalXpEarned  Int      @default(0) @map("total_xp_earned") //phase 2
  isPassed       Boolean  @map("is_passed")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  student    User       @relation(fields: [studentUserId], references: [id], onDelete: Restrict)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@unique([studentUserId, assignmentId])
  @@map("assignment_best_scores")
}


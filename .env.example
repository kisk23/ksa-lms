# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_dev?schema=public"

# ──────────────────────────────────────────
# API (NestJS)
# ──────────────────────────────────────────
API_PORT=4000
API_PREFIX=/api/v1
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# ──────────────────────────────────────────
# Frontend (Next.js)
# ──────────────────────────────────────────
# Browser calls same-origin /api/v1 (proxied to NestJS via next.config rewrites)
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_replace_me

# TODO: Replace with the official Sulam contact email once the domain is ready.
# Used in the About page CTA mailto link.
NEXT_PUBLIC_CONTACT_EMAIL=contact@sulam.sa

# Moyasar sandbox
MOYASAR_SECRET_KEY=sk_test_replace_me
MOYASAR_PUBLISHABLE_KEY=pk_test_replace_me
MOYASAR_BASE_URL=https://api.moyasar.com/v1
# Optional: only set if your Moyasar webhook configuration sends an HMAC signature.
MOYASAR_WEBHOOK_SECRET=

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ──────────────────────────────────────────
# File Storage (S3 / MinIO)
# ──────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lms-uploads

# ──────────────────────────────────────────
# Mail
# ──────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@lms.local
